[sub_resource type="GDScript" id="GDScript_1epan"]
script/source = "extends Node2D

var gold_preload = preload(\"res://Player/Collect/Gold.tscn\")

func _ready():
	Signals.connect(\"enemy_died\", Callable (self, \"_on_enemy_died\"))

func _on_enemy_died (enemy_position, state):
	if state != 5:
		for i in randi_range(1,5):
			gold_spawn(enemy_position)
			await get_tree().create_timer(0.05).timeout
	
	
func gold_spawn(pos):
	var gold = gold_preload.instantiate()
	gold.position = pos
	call_deferred(\"add_child\", gold)
#Таймер с отсчетом 10 секунд на спавн игровых монет
#func _on_timer_timeout():
	#var goldTemp = gold.instantiate()
	#var rng = RandomNumberGenerator.new()
	#var randint = randi_range(50,500)
	#goldTemp.position = Vector2(randint, 540)
	#add_child(goldTemp)
"

